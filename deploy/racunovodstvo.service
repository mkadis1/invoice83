[Unit]
Description=Invoice83 Racunovodstvo Server
After=network.target

[Service]
User=admin
WorkingDirectory=/home/admin/racunovodstvo
Environment="SERVER_MODE=1"
Environment="PORT=8000"
ExecStart=/home/admin/racunovodstvo/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
